[
	{
		"position": "top",
		"layer": "bottom",
		"reload_style_on_change": true,
 
		"modules-left": [ "hyprland/workspaces", "group/monitoring" ],
		"modules-center": [ ],
		"modules-right": [ "group/traygroup", "custom/weather", "pulseaudio#volume", "pulseaudio#microphone", "group/gnetwork", "group/gclock" ],

    "hyprland/window": {
			"format": "{title}"
		},

    "hyprland/workspaces": {
			"format": "<span>{icon}</span>",
			"persistent-workspaces": { "*": 10 },
			"format-icons": { "active": "\uf111", "default": "\uf10c", "empty": "\uf10c" }
		},

    "group/monitoring": {
			"orientation": "horizontal",
			"modules": [ "cpu", "memory", "temperature#cpu", "temperature#gpu", "disk", "custom/uptime" ],
			"drawer": {
				"transition-duration": 300
			}
		},
  
    "cpu": {
			"interval": 1,
			"format": "<span>\uf4bc</span>  {usage}%",
			"tooltip": false
		},

		"memory": {
			"interval": 1,
			"format": "RAM:  <span>\uf1c0</span>  {used:0.1f}GiB",
			"tooltip-format": "RAM: {used:0.1f}GiB\nZRAM: {swapUsed:0.1f}GiB"
		},

    "temperature#cpu": {
			// Please enter your hwmon path for the desired device here.
			"hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
			"format": "CPU:  <span>\uf2cb</span>  {temperatureC}°C",
			"interval": 1,
			"tooltip": false
		},

		"temperature#gpu": {
			// Please enter your hwmon path for the desired device here.
			"hwmon-path": "/sys/class/hwmon/hwmon1/temp2_input",
			"format": "GPU:  <span>\uf2cb</span>  {temperatureC}°C",
			"interval": 1,
			"tooltip": false
		},	

    "disk": {
        "format": "Disk: <span>\uf0a0</span>  {free}"
    },

    "custom/uptime": {
			"format": "<span>\uf062</span>  Up {}",
			"exec": "awk '{d=int($1/86400); h=int(($1%86400)/3600); m=int(($1%3600)/60); if (d >= 7) { print int(d/7) \"w \" d%7 \"d \" h \"h \" m \"m\"; } else if (d > 0) { print d \"d \" h \"h \" m \"m\"; } else { print h \"h \" m \"m\"; }}' /proc/uptime",
			"interval": 30,
			"tooltip": false
		},	

    "group/traygroup": {
			"orientation": "horizontal",
			"modules": [ "custom/tray-icon",  "tray" ],
			"drawer": {
				"transition-duration": 300,
				"transition-left-to-right": false
			}
		},

		"custom/tray-icon": {
			"format": "<span size='13000'>\udb80\udc4e</span>",
			"tooltip": false
		},

    "tray": {
			"icon-size": 14,
			"spacing": 10,
			"show-passive-items": true
		},

		"pulseaudio#microphone": {
			"format-source-muted": "<span>\udb80\udf6d</span>  {volume}%",
			"format-source": "<span>\udb80\udf6c</span>  {volume}%",
			"on-click": "swayosd-client --input-volume  mute-toggle",
			"on-scroll-up": "swayosd-client --input-volume +5",
			"on-scroll-down": "swayosd-client --input-volume -5",
			"on-click-right": "pavucontrol",
			"format": "{format_source}",
			"scroll-step": 1,
			"tooltip": false
		},

		"pulseaudio#volume": {
			"on-click": "swayosd-client --output-volume mute-toggle",
			"on-scroll-up": "swayosd-client --output-volume +5",
			"on-scroll-down": "swayosd-client --output-volume -5",
			"on-click-right": "pavucontrol",
			"format": "<span>\uf028</span>  {volume}%",
			"format-muted": "<span>\ueee8</span>  {volume}%",
			"scroll-step": 1,
			"tooltip": false
		},	

		"group/gclock": {
			"orientation": "horizontal",
			"modules": [ "clock", "clock#date" ],
			"drawer": {
				"transition-left-to-right": false,
				"transition-duration": 300
			}
		},	

		"group/gnetwork": {
			"orientation": "horizontal",
			"modules": [ "network",  "network#download", "network#upload" ],
			"drawer": {
				"transition-duration": 300,
				"transition-left-to-right": false
			}
		},

    "network": {
			"format-wifi": "<span>{icon}</span>  WiFi",
			"format-ethernet": "<span>\udb80\ude00</span>  Ethernet",
			"format-disconnected": "<span>\udb82\udd2e</span>  Offline",
			"format-icons": [ "\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28" ],
			"tooltip-format-ethernet": "Using ethernet connection",
			"tooltip-format": "Connected to {essid}"
		},	

		"network#download": {
			"format-wifi": "<span>\udb80\uddda</span>  {bandwidthDownBytes}",
			"format-ethernet": "<span>\udb80\uddda</span>  {bandwidthDownBytes}",
			"format-disconnected": "",
			"tooltip": false,
			"interval": 1
		},

		"network#upload": {
			"format-wifi": "<span>\udb81\udd52</span>  {bandwidthUpBytes}",
			"format-ethernet": "<span>\udb81\udd52</span>  {bandwidthUpBytes}",
			"format-disconnected": "",
			"tooltip": false,
			"interval": 1
		},	

		"clock": {
			"format": "<span>\udb85\udc4e</span>  {:%I:%M %p}",
			"tooltip": false
		},

		"clock#date": {
			"format": "<span>\udb83\ude18</span>   {:%A - %B %d, %Y}",
			"tooltip": false
		},
	}
]

// vim:ft=jsonc
