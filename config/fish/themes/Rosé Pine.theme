# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
# modified

fish_color_normal e1e1e1
fish_color_command b6b6b6
fish_color_keyword c0c0c0
fish_color_quote c8c8c8
fish_color_redirection 636363
fish_color_end 909090
fish_color_error 989898
fish_color_param c9c9c9
fish_color_comment 909090
# fish_color_match --background=brblue
fish_color_selection --reverse
# fish_color_history_current --bold
fish_color_operator e1e1e1
fish_color_escape 636363
fish_color_autosuggestion 909090
fish_color_cwd c9c9c9
# fish_color_cwd_root red
fish_color_user c8c8c8
fish_color_host c0c0c0
fish_color_host_remote b6b6b6
fish_color_cancel e1e1e1
fish_color_search_match --background=101010
fish_color_valid_path

